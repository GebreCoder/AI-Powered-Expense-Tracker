# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# --- Server ---
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/expense_tracker
JWT_SECRET=change_this_to_a_strong_secret
NODE_ENV=development

# --- CORS ---
# The frontend origin allowed to call this API.
FRONTEND_URL=http://localhost:5173

# --- AI Insights (optional) ---
# Generate a Gemini API key (free tier) at https://aistudio.google.com/apikey
# Without a key the API falls back to built-in rule-based insights.
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash

# --- Demo Bank (simulation only, never connects to a real bank) ---
# Master switch for the demo bank feature. Defaults to enabled in development
# and disabled in production.
DEMO_BANK_ENABLED=true
# Background generator that posts a fictional transaction every few minutes.
# Backend-enforced; defaults to enabled in development, disabled in production.
DEMO_BANK_SIMULATION_ENABLED=true
# Seconds between simulated transactions (min 30).
DEMO_BANK_TRANSACTION_INTERVAL=180
# When true, the connect flow reveals the simulated OTP in the API response
# so a presenter can complete verification without reading logs.
DEMO_BANK_DEV_MODE=true
# Percentage of a category budget that triggers a "spend alert" toast when a
# synced transaction pushes it past the mark (default 80). 100% always alerts.
DEMO_BANK_BUDGET_ALERT_THRESHOLD=80
